+// Reload a card team without replacing bots whose identity and loadout have
+// not changed. The admin applies the new file first, then evicts only changed
+// cards. Rebinding seats by pinned name keeps a dragged card's weapons on its
+// next respawn even though its priority number moved.
+public Action Command_ReloadBotCards(int client, int args)
+{
+	Config_LoadBotNames();
+	Config_LoadServerLoadout();
+	if (m_kvServerLoadout == null)
+	{
+		ReplyToCommand(client, "[BM3] No card loadout file to reload.");
+		return Plugin_Handled;
+	}
+	int rebound;
+	for (int bot = 1; bot <= MaxClients; bot++)
+	{
+		if (!IsClientInGame(bot) || !IsDefenderBot(bot) || TF2_GetClientTeam(bot) != TFTeam_Red)
+		{
+			continue;
+		}
+		char current[128];
+		GetClientName(bot, current, sizeof(current));
+		for (int seat = 1; seat <= redbots_manager_defender_team_size.IntValue; seat++)
+		{
+			char key[8], name[128], wantedClass[32];
+			IntToString(seat, key, sizeof(key));
+			m_kvServerLoadout.Rewind();
+			if (!m_kvServerLoadout.JumpToKey("seats") || !m_kvServerLoadout.JumpToKey(key)) continue;
+			m_kvServerLoadout.GetString("name", name, sizeof(name));
+			m_kvServerLoadout.GetString("class", wantedClass, sizeof(wantedClass));
+			if (StrEqual(name, current, false) && TF2_GetClassIndexFromString(wantedClass) == TF2_GetPlayerClass(bot))
+			{
+				m_iBotSeat[bot] = seat;
+				rebound++;
+				break;
+			}
+		}
+	}
+	m_kvServerLoadout.Rewind();
+	ReplyToCommand(client, "[BM3] Card loadouts reloaded; %d existing bot seats rebound.", rebound);
+	return Plugin_Handled;
+}
+
